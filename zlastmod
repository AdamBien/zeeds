#!/usr/bin/env -S java --source 25

/**
 * zlastmod - Prints the most recently modified files in a folder, searching all subfolders.
 *
 * Configuration is loaded from (each overwrites the previous):
 *   1. $HOME/.zlastmod/app.properties  (global)
 *   2. ./app.properties                (local, current directory)
 *   3. -D system properties            (CLI overrides)
 *
 * Configurable properties:
 *   skip=.git,.DS_Store   comma-separated glob patterns; matching files and folders are ignored
 *
 * Examples:
 *   zlastmod
 *   zlastmod ~/work -count:10
 *   zlastmod -Dskip=.git,target,*.class ~/work
 *
 * Configuration based on https://github.com/AdamBien/zcfg
 */

import java.io.IOException;
import java.io.PrintStream;
import java.nio.file.*;
import java.nio.file.attribute.BasicFileAttributes;
import java.nio.file.attribute.FileTime;
import java.time.ZoneId;
import java.time.format.DateTimeFormatter;
import java.util.*;
import java.util.stream.*;

static String APP_NAME = MethodHandles.lookup().lookupClass().getName();
static String PROPERTIES_FILE = "app.properties";
static String SKIP_KEY = "skip";
static String SKIP_DEFAULT = ".git,.DS_Store";

String version = "2026-11-09.1";

enum Log {
    ERROR(Color.BRIGHT_RED, System.err),
    USER(Color.BRIGHT_WHITE, System.out),
    INFO(Color.BRIGHT_GREEN, System.out);

    enum Color {
        BRIGHT_RED("\033[38;5;196m"),
        BRIGHT_WHITE("\033[38;5;255m"),
        BRIGHT_GREEN("\033[38;5;46m");

        final String code;
        Color(String code) { this.code = code; }
    }

    static final String RESET = "\u001B[0m";
    final String value;
    final PrintStream out;

    Log(Color color, PrintStream out) {
        this.value = color.code + "%s" + RESET;
        this.out = out;
    }

    void out(String message) { this.out.println(this.value.formatted(message)); }

    static void info(String message) { INFO.out(message); }
    static void user(String message) { USER.out(message); }
    static void error(String message) { ERROR.out(message); }
    static void stop(String message) {
        error(message);
        System.exit(1);
    }
}

enum Arg {
    COUNT("-count", "Number of files to show (default: 5)"),
    HELP("-help", "Show this help"),
    VERSION("-version", "Show version");

    final String option;
    final String description;

    Arg(String option, String description) {
        this.option = option;
        this.description = description;
    }

    boolean matches(String value) {
        return this.option.equals(value)
            || value.startsWith(this.option + ":");
    }

    String value(String arg) {
        var prefix = this.option + ":";
        if (!arg.startsWith(prefix)) Log.stop("Missing value for " + this.option + ", expected " + prefix + "VALUE");
        return arg.substring(prefix.length());
    }

    static Arg from(String value) {
        return Stream.of(values())
            .filter(a -> a.matches(value))
            .findFirst()
            .orElse(null);
    }

    static String usage() {
        return Stream.of(values())
            .map(a -> "  %-12s %s".formatted(a.option, a.description))
            .collect(Collectors.joining("\n"));
    }
}

record Args(Path folder, int count) {}

void main(String... args) throws Exception {
    Log.info(APP_NAME + " " + version);
    var parsed = parseArgs(args);
    if (!Files.isDirectory(parsed.folder())) {
        Log.stop("Not a directory: " + parsed.folder());
    }
    ZCfg.load(APP_NAME);
    var skip = skipMatchers(ZCfg.string(SKIP_KEY, SKIP_DEFAULT));
    var newest = findLastModified(parsed.folder(), parsed.count(), skip);
    if (newest.isEmpty()) {
        Log.stop("No files found in " + parsed.folder());
    }
    var formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
    for (var file : newest) {
        var modified = lastModified(file).toInstant().atZone(ZoneId.systemDefault());
        Log.user(modified.format(formatter) + "  " + file.normalize());
    }
}

Args parseArgs(String[] args) {
    var folders = new ArrayList<String>();
    var count = 5;
    for (var arg : args) {
        switch (Arg.from(arg)) {
            case COUNT -> count = parseCount(Arg.COUNT.value(arg));
            case HELP -> printUsage();
            case VERSION -> System.exit(0);
            case null -> {
                if (arg.startsWith("-")) Log.stop("Unknown option: " + arg);
                folders.add(arg);
            }
        }
    }
    if (folders.size() > 1) {
        Log.stop("Expected at most one folder, got: " + folders);
    }
    return new Args(Path.of(folders.isEmpty() ? "." : folders.getFirst()), count);
}

int parseCount(String value) {
    try {
        var count = Integer.parseInt(value);
        if (count < 1) Log.stop("Count must be at least 1, got: " + value);
        return count;
    } catch (NumberFormatException e) {
        Log.stop("Count must be a number, got: " + value);
        return 0;
    }
}

void printUsage() {
    Log.user("""
        Usage: %s [folder] [-count:N]

        Prints the most recently modified files in folder (default: current directory),
        searching all subfolders. Newest first.

        Options:
        %s

        Config sources (each overwrites previous):
          $HOME/.%1$s/%s
          ./%3$s
          -D flags (e.g., -D%s=.git,target,*.class)

        Configurable properties:
          %4$s=%s   comma-separated glob patterns; matching files and folders are skipped
        """.formatted(APP_NAME, Arg.usage(), PROPERTIES_FILE, SKIP_KEY, SKIP_DEFAULT));
    System.exit(0);
}

List<PathMatcher> skipMatchers(String patterns) {
    var fileSystem = FileSystems.getDefault();
    return Stream.of(patterns.split(","))
        .map(String::trim)
        .filter(p -> !p.isEmpty())
        .map(p -> fileSystem.getPathMatcher("glob:" + p))
        .toList();
}

boolean skipped(Path path, List<PathMatcher> skip) {
    var name = path.getFileName();
    return name != null && skip.stream().anyMatch(m -> m.matches(name));
}

List<Path> findLastModified(Path folder, int count, List<PathMatcher> skip) throws IOException {
    var files = new ArrayList<Path>();
    Files.walkFileTree(folder, new SimpleFileVisitor<>() {
        @Override
        public FileVisitResult preVisitDirectory(Path dir, BasicFileAttributes attrs) {
            return !dir.equals(folder) && skipped(dir, skip)
                ? FileVisitResult.SKIP_SUBTREE
                : FileVisitResult.CONTINUE;
        }

        @Override
        public FileVisitResult visitFile(Path file, BasicFileAttributes attrs) {
            if (attrs.isRegularFile() && !skipped(file, skip)) files.add(file);
            return FileVisitResult.CONTINUE;
        }

        @Override
        public FileVisitResult visitFileFailed(Path file, IOException e) {
            return FileVisitResult.CONTINUE;
        }
    });
    return files.stream()
        .sorted(Comparator.comparing(this::lastModified).reversed())
        .limit(count)
        .toList();
}

FileTime lastModified(Path file) {
    try {
        return Files.getLastModifiedTime(file);
    } catch (Exception e) {
        return FileTime.fromMillis(0);
    }
}

class ZCfg {

    static Properties CACHE;

    static void load(String appName) {
        CACHE = loadProperties(appName);
    }

    static Properties loadProperties(String appName) {
        var properties = new Properties();
        var userHome = System.getProperty("user.home");
        var globalConfig = Path.of(userHome, "." + appName, PROPERTIES_FILE);
        if (Files.exists(globalConfig))
            loadFromFile(globalConfig, properties);
        var localConfig = Path.of(PROPERTIES_FILE);
        if (Files.exists(localConfig))
            loadFromFile(localConfig, properties);
        properties.putAll(System.getProperties());
        return properties;
    }

    static void loadFromFile(Path file, Properties properties) {
        try (var reader = Files.newBufferedReader(file)) {
            properties.load(reader);
        } catch (IOException e) {
            throw new IllegalStateException("Cannot load properties from: " + file, e);
        }
    }

    static String string(String key) {
        return CACHE.getProperty(key);
    }

    static String string(String key, String defaultValue) {
        return CACHE.getProperty(key, defaultValue);
    }
}
