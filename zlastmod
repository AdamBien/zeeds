#!/usr/bin/env -S java --source 25

import java.io.PrintStream;
import java.nio.file.*;
import java.nio.file.attribute.FileTime;
import java.time.ZoneId;
import java.time.format.DateTimeFormatter;
import java.util.*;
import java.util.stream.*;

String name = MethodHandles.lookup().lookupClass().getName();
String version = "2026-11-02.3";

enum Log {
    ERROR(Color.BRIGHT_RED, System.err),
    USER(Color.BRIGHT_WHITE, System.out),
    INFO(Color.BRIGHT_GREEN, System.out);

    enum Color {
        BRIGHT_RED("\033[38;5;196m"),
        BRIGHT_WHITE("\033[38;5;255m"),
        BRIGHT_GREEN("\033[38;5;46m");

        final String code;
        Color(String code) { this.code = code; }
    }

    static final String RESET = "\u001B[0m";
    final String value;
    final PrintStream out;

    Log(Color color, PrintStream out) {
        this.value = color.code + "%s" + RESET;
        this.out = out;
    }

    void out(String message) { this.out.println(this.value.formatted(message)); }

    static void info(String message) { INFO.out(message); }
    static void user(String message) { USER.out(message); }
    static void error(String message) { ERROR.out(message); }
    static void stop(String message) {
        error(message);
        System.exit(1);
    }
}

enum Arg {
    COUNT("-count", "Number of files to show (default: 5)"),
    HELP("-help", "Show this help"),
    VERSION("-version", "Show version");

    final String option;
    final String description;

    Arg(String option, String description) {
        this.option = option;
        this.description = description;
    }

    boolean matches(String value) {
        return this.option.equals(value)
            || value.startsWith(this.option + ":");
    }

    String value(String arg) {
        var prefix = this.option + ":";
        if (!arg.startsWith(prefix)) Log.stop("Missing value for " + this.option + ", expected " + prefix + "VALUE");
        return arg.substring(prefix.length());
    }

    static Arg from(String value) {
        return Stream.of(values())
            .filter(a -> a.matches(value))
            .findFirst()
            .orElse(null);
    }

    static String usage() {
        return Stream.of(values())
            .map(a -> "  %-12s %s".formatted(a.option, a.description))
            .collect(Collectors.joining("\n"));
    }
}

record Args(Path folder, int count) {}

void main(String... args) throws Exception {
    Log.info(name + " " + version);
    var parsed = parseArgs(args);
    if (!Files.isDirectory(parsed.folder())) {
        Log.stop("Not a directory: " + parsed.folder());
    }
    var newest = findLastModified(parsed.folder(), parsed.count());
    if (newest.isEmpty()) {
        Log.stop("No files found in " + parsed.folder());
    }
    var formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
    for (var file : newest) {
        var modified = lastModified(file).toInstant().atZone(ZoneId.systemDefault());
        Log.user(modified.format(formatter) + "  " + file.normalize());
    }
}

Args parseArgs(String[] args) {
    var folders = new ArrayList<String>();
    var count = 5;
    for (var arg : args) {
        switch (Arg.from(arg)) {
            case COUNT -> count = parseCount(Arg.COUNT.value(arg));
            case HELP -> printUsage();
            case VERSION -> System.exit(0);
            case null -> {
                if (arg.startsWith("-")) Log.stop("Unknown option: " + arg);
                folders.add(arg);
            }
        }
    }
    if (folders.size() > 1) {
        Log.stop("Expected at most one folder, got: " + folders);
    }
    return new Args(Path.of(folders.isEmpty() ? "." : folders.getFirst()), count);
}

int parseCount(String value) {
    try {
        var count = Integer.parseInt(value);
        if (count < 1) Log.stop("Count must be at least 1, got: " + value);
        return count;
    } catch (NumberFormatException e) {
        Log.stop("Count must be a number, got: " + value);
        return 0;
    }
}

void printUsage() {
    Log.user("""
        Usage: %s [folder] [-count:N]

        Prints the most recently modified files in folder (default: current directory),
        searching all subfolders. Newest first.

        Options:
        %s
        """.formatted(name, Arg.usage()));
    System.exit(0);
}

List<Path> findLastModified(Path folder, int count) throws Exception {
    try (var files = Files.walk(folder)) {
        return files.filter(Files::isRegularFile)
                .sorted(Comparator.comparing(this::lastModified).reversed())
                .limit(count)
                .toList();
    }
}

FileTime lastModified(Path file) {
    try {
        return Files.getLastModifiedTime(file);
    } catch (Exception e) {
        return FileTime.fromMillis(0);
    }
}
