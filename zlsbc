#!/usr/bin/env -S java --source 25

import module java.base;

String name = MethodHandles.lookup().lookupClass().getName();
String version = "2026-09-11.3";

enum Log {

    COMPONENT("\033[38;2;42;161;152m");   // Solarized Cyan #2aa198

    private final String value;
    private static final String RESET = "\033[0m";

    Log(String color) {
        this.value = color + "%s" + RESET;
    }

    void out(String message) {
        System.out.println(this.value.formatted(message));
    }

    public static void component(String message) {
        Log.COMPONENT.out(message);
    }
}

List<BusinessComponent> findBusinessComponents(Path root) throws IOException {
    try (var tree = Files.walk(root)) {
        return tree
                .filter(Files::isDirectory)
                .filter(path -> !insideTestFolder(root.relativize(path)))
                .map(this::componentOf)
                .filter(BusinessComponent::isComponent)
                .sorted(Comparator.comparing(BusinessComponent::path))
                .toList();
    }
}

boolean insideTestFolder(Path relative) {
    return StreamSupport.stream(relative.spliterator(), false)
            .anyMatch(segment -> segment.toString().toLowerCase().contains("test"));
}

BusinessComponent componentOf(Path path) {
    return new BusinessComponent(path, layersOf(path));
}

List<Layer> layersOf(Path component) {
    try (var children = Files.list(component)) {
        return children
                .filter(Files::isDirectory)
                .filter(child -> Layer.NAMES.contains(child.getFileName().toString()))
                .map(this::layerOf)
                .sorted(Comparator.comparing(Layer::name))
                .toList();
    } catch (IOException notReadable) {
        return List.of();
    }
}

Layer layerOf(Path path) {
    return new Layer(path.getFileName().toString(), countClasses(path));
}

long countClasses(Path layer) {
    try (var children = Files.list(layer)) {
        return children
                .filter(Files::isRegularFile)
                .filter(file -> file.getFileName().toString().endsWith(".java"))
                .count();
    } catch (IOException notReadable) {
        return 0;
    }
}

record Layer(String name, long classes) {

    static final Set<String> NAMES = Set.of("boundary", "control", "entity");

    String describe() {
        return "%s (%d)".formatted(name, classes);
    }
}

record BusinessComponent(Path path, List<Layer> layers) {

    boolean isComponent() {
        return !layers.isEmpty();
    }

    String describe(Path root, boolean full) {
        var display = full ? root.relativize(path) : path.getFileName();
        var described = layers.stream()
                .map(Layer::describe)
                .collect(Collectors.joining(", "));
        return "%s [%s]".formatted(display, described);
    }
}

void main(String... args) throws Exception {
    IO.println(name + " " + version);
    var arguments = List.of(args);
    if (arguments.contains("-help")) {
        IO.println("""
                Usage: %s [directory] [-full]
                  Lists all business components (BCs) — directories
                  containing a boundary, control, or entity layer —
                  with the number of Java classes in each layer.
                  Defaults to the current directory.
                  Folders containing "test" are ignored.
                  -full  Show the complete path of each component
                  -help  Show this help
                """.formatted(name));
        return;
    }
    var full = arguments.contains("-full");
    var root = Path.of(arguments.stream()
            .filter(argument -> !argument.startsWith("-"))
            .findFirst()
            .orElse("."));
    if (!Files.isDirectory(root)) {
        System.err.println("Error: not a directory: " + root);
        System.exit(1);
    }
    var components = findBusinessComponents(root);
    if (components.isEmpty()) {
        System.err.println("No business components found in " + root);
        return;
    }
    components.stream()
            .map(bc -> bc.describe(root, full))
            .distinct()
            .forEach(Log::component);
}
